{
  "name": "ned-bot",
  "version": "1.0.0",
  "description": "Modular Discord bot with pluggable modules",
  "private": true,
  "type": "module",
  "main": "build/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/dev.ts",
    "start": "node build/main.js",
    "sync:commands": "tsx src/sync-commands.ts",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ned-bot",
    "pm2:restart": "pm2 restart ned-bot",
    "pm2:logs": "pm2 logs ned-bot",
    "pm2:delete": "pm2 delete ned-bot",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@discordx/importer": "^1.3.3",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "discord.js": "^14.27.0",
    "discordx": "^11.13.3",
    "dotenv": "^18.0.5",
    "fast-xml-parser": "^5.11.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "xnotif": "^0.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "pm2": "^7.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
